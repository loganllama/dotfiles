{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "mcp__ide__getDiagnostics",
      "Edit(//workspaces/obsidian-ws/**)",
      "Write(//workspaces/obsidian-ws/**)",
      "Bash(jj:*)",
      "Bash(gh pr:*)",
      "Bash(EDITOR=\"true\" jj squash:*)",
      "Bash(xargs ls:*)",
      "Bash(ws:*)"
    ],
    "deny": ["Bash(jj git:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env capn context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/bin/ws-hook\" ] || \"$HOME/bin/ws-hook\""
          }
        ]
      }
    ]
  }
}
